MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = minimal
ENABLE_HARDENED_RUNTIME = YES
ENABLE_APP_SANDBOX = NO
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = YES
ENABLE_PREVIEWS = YES
COMBINE_HIDPI_IMAGES = YES

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

INFOPLIST_KEY_CFBundleDevelopmentRegion = zh-Hans
INFOPLIST_KEY_CFBundleLocalizations = zh-Hans en
INFOPLIST_KEY_CFBundleDisplayName = $(BUNDLE_DISPLAY_NAME)
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.finance
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_NSHumanReadableCopyright = © 2026 StockBar contributors
